# ROS/catkin generated outputs
build/
devel/
install/
log/

# Python caches and local test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local editor and agent state
.vscode/
.idea/
.agents/
.codex/

# Runtime outputs
output/

# Large raw mapping artifacts
*.bag
*.pcd

# Device-local planner configuration and map origin
/tools/path_creater/config/config.yaml
/tools/path_creater/config/map_enu.meta.yaml

# Keep lightweight static planning maps tracked.
!map/pgm/*.pgm
!map/pgm/*.yaml

# Project-local Melodic runtime and Python build cache
.runtime/
