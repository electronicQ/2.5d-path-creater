<launch>
    <node pkg="gnss_to_enu" type="gnss_to_enu.py" name="gnss_to_enu_node" output="screen">
        <param name="sub_topic" value="/handsfree/rtk/gnss" />
        <param name="pub_topic" value="/rtk/gps_odom" />

        <param name="use_auto_datum" value="false" />

        <param name="datum_lat" value="22.56585751" />
        <param name="datum_lon" value="113.49363254" />
        <param name="datum_alt" value="4.79080000" />

        <param name="min_T_intervel" value="0.2" />
        <param name="min_D_interval" value="0.2" />
    </node>
</launch>