<launch>
    <!--
      banfu2.bag:
        /livox/lidar first header stamp:      441.69998552
        /handsfree/rtk/gnss first header stamp: 1782701507.671617
      offset_seconds = GNSS - LiDAR = 1782701065.9716315
    -->
    <arg name="offset_seconds" default="1782701065.9716315" />
    <arg name="sub_topic" default="/handsfree/rtk/gnss" />
    <arg name="pub_topic" default="/handsfree/rtk/gnss_time_aligned" />

    <node pkg="gnss_to_enu"
          type="gnss_timestamp_compensator.py"
          name="gnss_timestamp_compensator"
          output="screen">
        <param name="sub_topic" value="$(arg sub_topic)" />
        <param name="pub_topic" value="$(arg pub_topic)" />
        <param name="offset_seconds" value="$(arg offset_seconds)" />
    </node>
</launch>
