[Unit]
Description=Ground vehicle navigation TCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=union
WorkingDirectory=/home/union/2.5d-path-creater
Environment=HOME=/home/union
Environment=ROS_HOME=/home/union/.ros
Environment=ROS_LOG_DIR=/home/union/.ros/log
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/union/2.5d-path-creater/scripts/run_vehicle.sh --config /home/union/2.5d-path-creater/tools/ground_vehicle_tcp/config.yaml
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
