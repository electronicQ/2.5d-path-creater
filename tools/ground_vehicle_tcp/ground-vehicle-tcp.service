[Unit]
Description=Ground vehicle navigation TCP server
After=roscore.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/muti_path_creater
ExecStart=/bin/bash -lc 'source devel/setup.bash && exec python3 -m tools.ground_vehicle_tcp.main --config tools/ground_vehicle_tcp/config.yaml'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
