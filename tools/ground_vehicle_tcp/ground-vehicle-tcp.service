[Unit]
Description=Ground vehicle navigation TCP server
After=roscore.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/muti_path_creater
ExecStart=/bin/bash /opt/muti_path_creater/scripts/run_vehicle.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
